        <mxCell id="110" value="Future-proofing: keep search terms in aliases and tags, keep snippets separate from concepts, and add users/bookmarks only when the UI needs them." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
